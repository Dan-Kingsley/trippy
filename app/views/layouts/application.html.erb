<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Trippy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Trippy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/trippy-logo.png" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/trippy-logo-dark.png" type="image/png" media="(prefers-color-scheme: dark)">
    <link rel="apple-touch-icon" href="/trippy-logo.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script>
      // Apply the stored/system theme before first paint to avoid a flash of the wrong theme.
      (function () {
        var stored = localStorage.getItem("trippy-theme");
        var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <header class="border-b border-stone-200 dark:border-stone-800 bg-stone-50/90 dark:bg-stone-900/90 backdrop-blur sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-1.5 sm:gap-4">
        <%= link_to root_path, class: "flex items-center gap-1.5 sm:gap-2 font-bold text-lg sm:text-xl text-amber-800 dark:text-amber-400 shrink-0" do %>
          <%= image_tag "/trippy-logo.png", alt: "Trippy", class: "h-7 w-7 sm:h-8 sm:w-8 rounded-md dark:invert" %> Trippy
        <% end %>

        <div class="flex items-center gap-1 sm:gap-3 min-w-0">
          <div data-controller="theme">
            <button type="button" data-action="theme#toggle" aria-label="Toggle dark mode"
              class="p-1.5 sm:p-2 rounded-full text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-800 cursor-pointer">
              <span data-theme-target="lightIcon">☀️</span>
              <span data-theme-target="darkIcon" class="hidden">🌙</span>
            </button>
          </div>

          <%= render "shared/locale_modal" unless authenticated? %>

          <%= render "shared/private_access_modal" %>

          <% if authenticated? %>
            <div class="flex items-center gap-1 sm:gap-3 text-xs sm:text-sm">
              <% if Current.user.admin? %>
                <%= link_to t("layout.admin"), admin_users_path, class: "px-1.5 sm:px-0 whitespace-nowrap text-stone-600 dark:text-stone-300 hover:text-amber-700 dark:hover:text-amber-400" %>
              <% end %>
              <% if Current.user.adventurer? %>
                <%= link_to t("layout.my_trips"), trips_path, class: "px-1.5 sm:px-0 whitespace-nowrap text-stone-600 dark:text-stone-300 hover:text-amber-700 dark:hover:text-amber-400" %>
              <% end %>
              <%= link_to edit_settings_path, class: "flex items-center gap-1.5 text-stone-500 dark:text-stone-400 hover:text-amber-700 dark:hover:text-amber-400" do %>
                <%= avatar_tag Current.user, size: 48, css_class: "w-6 h-6 text-[10px]" %>
                <span class="hidden md:inline"><%= Current.user.username %></span>
              <% end %>
            </div>
          <% else %>
            <div class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm">
              <%= link_to t("layout.sign_in"), new_session_path, class: "whitespace-nowrap rounded-md px-2 sm:px-3 py-1.5 text-stone-700 dark:text-stone-200 hover:bg-stone-200 dark:hover:bg-stone-800" %>
              <%= link_to t("layout.sign_up"), new_registration_path, class: "whitespace-nowrap rounded-md px-2 sm:px-3 py-1.5 bg-amber-700 hover:bg-amber-600 text-white font-medium" %>
            </div>
          <% end %>
        </div>
      </div>
    </header>

    <main class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 flex-1">
      <%= render "shared/flashes" %>
      <%= yield %>
    </main>

    <footer class="text-center text-xs text-stone-400 dark:text-stone-500 py-6">
      <%= link_to "Trippy - Open Source Trip Tracking - GPL-3.0", "https://github.com/Dan-Kingsley/trippy",
            target: "_blank", rel: "noopener", class: "hover:text-stone-600 dark:hover:text-stone-300" %>
    </footer>
  </body>
</html>
