<% timed_photos = entry.persisted? ? entry.photos.select(&:taken_at) : [] %>
<% auto_time = TripEntry.mean_time(timed_photos) %>

<div data-controller="toggle">
  <% if auto_time %>
    <p class="text-xs text-stone-500 dark:text-stone-400 mb-2">
      <%= t("trip_entries.datetime_field.automatic_label") %> <strong><%= l(auto_time, format: :trippy_short) %></strong>
    </p>
  <% else %>
    <p class="text-xs text-stone-400 dark:text-stone-500 mb-2"><%= t("trip_entries.datetime_field.none_found") %></p>
  <% end %>

  <div class="flex items-center gap-2">
    <%= form.check_box :manual_time, class: "rounded border-stone-300 dark:border-stone-700 text-amber-700",
          data: { action: "toggle#sync", photo_date_target: "timeCheckbox" } %>
    <%= form.label :manual_time, t("trip_entries.datetime_field.manual_label"), class: "text-sm text-stone-600 dark:text-stone-300" %>
  </div>
  <div data-toggle-target="revealable" class="hidden mt-2" data-controller="datetime-picker">
    <%= form.hidden_field :occurred_at, data: { datetime_picker_target: "hidden" } %>
    <div class="flex gap-2">
      <input type="date" data-datetime-picker-target="date" data-action="input->datetime-picker#combine"
        class="rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2">
      <input type="time" data-datetime-picker-target="time" data-action="input->datetime-picker#combine"
        class="rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2">
      <button type="button" data-action="datetime-picker#setNow"
        class="shrink-0 rounded-md px-3 py-2 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 text-sm font-medium cursor-pointer"><%= t("trip_entries.datetime_field.now") %></button>
    </div>
    <p class="text-xs text-stone-400 mt-1"><%= t("trip_entries.datetime_field.help_text") %></p>
  </div>
</div>
