<% content_for :title, "Edit entry - #{@trip.title} - Trippy" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
<% end %>

<h1 class="font-bold text-3xl mb-6 text-stone-800 dark:text-stone-100">Edit entry</h1>

<% if @entry.photos.any? %>
  <section class="mb-8 max-w-lg">
    <h2 class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-2">Photos <span class="text-stone-400">(drag to reorder &mdash; first photo is used as the entry/trip thumbnail)</span></h2>
    <div data-controller="reorder" class="flex flex-wrap gap-3">
      <% @entry.photos.each do |photo| %>
        <div data-reorder-target="item" data-url="<%= trip_trip_entry_photo_path(@trip, @entry, photo) %>" class="relative cursor-move">
          <%= photo_thumb_tag photo, size: 96, css_class: "w-24 h-24 rounded-lg object-cover border border-stone-200 dark:border-stone-800" %>
          <%= button_to "&times;".html_safe, trip_trip_entry_photo_path(@trip, @entry, photo), method: :delete,
                form: { data: { turbo_confirm: "Remove this photo?" } },
                class: "absolute -top-2 -right-2 w-6 h-6 rounded-full bg-red-600 hover:bg-red-500 text-white text-sm leading-none cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<%= form_with url: trip_trip_entry_photos_path(@trip, @entry), method: :post, multipart: true, class: "mb-8 max-w-lg",
      data: { controller: "photo-date", photo_date_direct_upload_url_value: rails_direct_uploads_path } do |form| %>
  <div class="flex items-end gap-3">
    <div class="flex-1 min-w-0">
      <%= form.label :photos, "Add more photos or videos", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
      <label for="more_entry_photos" class="inline-flex items-center gap-2 rounded-md px-4 py-2 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 font-medium cursor-pointer">
        📷 <span data-photo-date-target="fileCount">Choose photos or videos</span>
      </label>
      <input type="file" id="more_entry_photos" name="photos[]" multiple accept="image/*,video/*" class="sr-only"
             data-photo-date-target="input" data-action="change->photo-date#preview">
    </div>
    <%= form.submit "Upload", data: { photo_date_target: "submit" }, class: "shrink-0 rounded-md px-4 py-2 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
  </div>
  <p class="text-xs text-stone-400 mt-1">You can also paste an image from your clipboard anywhere in this form.</p>
  <p data-photo-date-target="status" class="hidden text-xs mt-1 text-amber-700 dark:text-amber-400"></p>
  <div data-photo-date-target="uploadList" class="hidden mt-2 space-y-1"></div>
<% end %>

<%= form_with model: @entry, url: trip_trip_entry_path(@trip, @entry), class: "space-y-6 max-w-lg" do |form| %>
  <% if @entry.errors.any? %>
    <div class="rounded-lg bg-red-50 dark:bg-red-900/40 px-4 py-2.5 text-red-600 dark:text-red-300 text-sm">
      <ul class="list-disc list-inside">
        <% @entry.errors.full_messages.each { |m| concat(content_tag(:li, m)) } %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
    <%= form.text_field :title, required: true,
          class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
  </div>

  <div>
    <%= form.label :description, "Description (Markdown supported)", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
    <%= form.text_area :description, rows: 5,
          class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
  </div>

  <%= render "location_field", form: form, entry: @entry %>

  <%= render "who_else_field", trip: @trip, entry: @entry, exclude_user_id: @entry.created_by_id %>

  <%= render "datetime_field", form: form, entry: @entry %>

  <%= form.submit "Save changes", class: "rounded-md px-4 py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
<% end %>

<div class="mt-10 pt-6 border-t border-stone-200 dark:border-stone-800 max-w-lg">
  <h2 class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-2">Danger zone</h2>
  <%= button_to "Delete entry", trip_trip_entry_path(@trip, @entry), method: :delete,
        form: { data: { turbo_confirm: "Delete this entry and its photos?" } },
        class: "rounded-md px-3 py-1.5 bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50 text-red-700 dark:text-red-300 text-sm font-medium cursor-pointer" %>
</div>
