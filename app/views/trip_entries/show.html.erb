<% content_for :title, "#{@entry.title} - #{@trip.title} - Trippy" %>

<%= link_to "&larr; #{@trip.title}".html_safe, trip_path(@trip), class: "inline-flex items-center gap-1 rounded-md px-3 py-2 bg-amber-700 hover:bg-amber-600 text-white text-sm font-medium mb-4" %>

<% if @editable %>
  <div class="flex gap-2 mb-4">
    <%= link_to "Edit entry", edit_trip_trip_entry_path(@trip, @entry), class: "rounded-md px-3 py-1.5 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 text-sm font-medium" %>
  </div>
<% end %>

<div data-controller="carousel" data-action="keydown@window->carousel#onKeydown" tabindex="0" autofocus
  class="rounded-xl focus:outline-2 focus:outline-amber-600 focus:outline-offset-2">
  <% if @entry.photos.any? %>
    <div class="relative rounded-xl overflow-hidden bg-stone-200 dark:bg-stone-800">
      <div data-carousel-target="track" data-action="scroll->carousel#onScroll" class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">
        <% @entry.photos.each do |photo| %>
          <div class="snap-center shrink-0 w-full aspect-[4/3] sm:aspect-[16/9]">
            <%= image_tag photo.image.variant(:thumb),
                  class: "w-full h-full object-contain cursor-zoom-in",
                  data: { action: "click->carousel#open", full_src: url_for(photo.image.variant(:full)) } %>
          </div>
        <% end %>
      </div>

      <% if @entry.photos.size > 1 %>
        <button type="button" data-action="carousel#prev" aria-label="Previous photo"
          class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">&#8249;</button>
        <button type="button" data-action="carousel#next" aria-label="Next photo"
          class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">&#8250;</button>

        <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1.5">
          <% @entry.photos.each_with_index do |_photo, i| %>
            <button type="button" data-action="carousel#goTo" data-carousel-target="dot" data-index="<%= i %>" aria-label="Go to photo <%= i + 1 %>"
              class="w-2 h-2 rounded-full <%= i == 0 ? 'bg-white' : 'bg-white/40' %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div data-carousel-target="lightbox" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4 touch-none"
       data-action="click->carousel#close touchstart->carousel#onTouchStart touchmove->carousel#onTouchMove touchend->carousel#onTouchEnd wheel->carousel#onWheel:!passive mousedown->carousel#onMouseDown mousemove@window->carousel#onMouseMove mouseup@window->carousel#onMouseUp">
    <img data-carousel-target="lightboxImage" class="max-w-full max-h-full object-contain touch-none active:cursor-grabbing" src="">

    <% if @entry.photos.size > 1 %>
      <button type="button" data-action="carousel#prev" aria-label="Previous photo"
        class="group absolute inset-y-0 left-0 w-[10%] flex items-center justify-start pl-2 cursor-pointer">
        <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 group-hover:bg-black/60 text-white rounded-full w-10 h-10 flex items-center justify-center text-2xl leading-none">&#8249;</span>
      </button>
      <button type="button" data-action="carousel#next" aria-label="Next photo"
        class="group absolute inset-y-0 right-0 w-[10%] flex items-center justify-end pr-2 cursor-pointer">
        <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 group-hover:bg-black/60 text-white rounded-full w-10 h-10 flex items-center justify-center text-2xl leading-none">&#8250;</span>
      </button>
    <% end %>
  </div>
</div>

<div class="mt-6 max-w-2xl">
  <h1 class="font-bold text-3xl text-stone-800 dark:text-stone-100"><%= @entry.title %></h1>
  <div class="flex items-center gap-2 mt-2">
    <div class="flex -space-x-2">
      <% @entry.participants.each do |user| %>
        <%= avatar_tag user, size: 56, css_class: "w-7 h-7 text-xs ring-2 ring-stone-50 dark:ring-stone-900" %>
      <% end %>
    </div>
    <% if @trip_member %>
      <p class="text-xs text-stone-500 dark:text-stone-400">
        <%= pluralize(@entry.views_count, "view") %>
      </p>
    <% end %>
  </div>
  <% if @entry.description.present? %>
    <div class="prose-trip mt-3 text-stone-700 dark:text-stone-200"><%= render_markdown(@entry.description) %></div>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 mt-5"
    <% if @editable %>
      data-controller="reaction-users"
      data-reaction-users-users-url-value="<%= users_trip_trip_entry_reactions_path(@trip, @entry) %>"
    <% end %>
  >
    <% @entry.displayed_reaction_emojis(user: Current.user).each do |emoji| %>
      <% count = @entry.reaction_counts[emoji].to_i %>
      <% mine = authenticated? && @entry.reactions.exists?(user: Current.user, emoji: emoji) %>
      <%= button_to "#{emoji} #{count > 0 ? count : ''}".strip, trip_trip_entry_reactions_path(@trip, @entry), method: :post,
            params: { emoji: emoji },
            class: "rounded-full px-3 py-1 text-sm border #{mine ? 'bg-amber-100 dark:bg-amber-900/40 border-amber-300 dark:border-amber-700' : 'bg-stone-100 dark:bg-stone-800 border-stone-200 dark:border-stone-700'} cursor-pointer",
            data: (@editable ? {
              emoji: emoji,
              action: "contextmenu->reaction-users#show touchstart->reaction-users#onTouchStart touchmove->reaction-users#onTouchMove touchend->reaction-users#onTouchEnd click->reaction-users#onClick"
            } : {}) %>
    <% end %>

    <% if authenticated? %>
      <% recent_emojis = Current.user.recent_emojis(limit: 6) %>
      <% has_reacted_before = Current.user.reactions.exists? %>
      <div class="relative" data-controller="emoji-picker">
        <button type="button" data-action="emoji-picker#toggle" aria-label="Add another reaction"
          class="rounded-full w-7 h-7 flex items-center justify-center text-sm border bg-stone-100 dark:bg-stone-800 border-stone-200 dark:border-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700 cursor-pointer">+</button>

        <div data-emoji-picker-target="popover" class="hidden absolute z-10 top-full left-0 mt-1 shadow-lg rounded-lg overflow-hidden bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700">
          <div class="flex text-xs font-medium border-b border-stone-200 dark:border-stone-700">
            <button type="button" data-action="emoji-picker#showRecent" data-emoji-picker-target="recentTab"
              class="flex-1 px-3 py-1.5 cursor-pointer <%= has_reacted_before ? 'text-amber-700 dark:text-amber-400 border-b-2 border-amber-600' : 'text-stone-500 dark:text-stone-400' %>">Recent</button>
            <button type="button" data-action="emoji-picker#showAll" data-emoji-picker-target="allTab"
              class="flex-1 px-3 py-1.5 cursor-pointer <%= has_reacted_before ? 'text-stone-500 dark:text-stone-400' : 'text-amber-700 dark:text-amber-400 border-b-2 border-amber-600' %>">All</button>
          </div>

          <div data-emoji-picker-target="recentPanel" class="<%= 'hidden' unless has_reacted_before %> p-2 flex flex-wrap gap-1 w-64">
            <% if recent_emojis.any? %>
              <% recent_emojis.each do |emoji| %>
                <button type="button" data-action="emoji-picker#selectRecent" data-emoji="<%= emoji %>"
                  class="rounded-full w-9 h-9 flex items-center justify-center text-lg hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer"><%= emoji %></button>
              <% end %>
            <% else %>
              <p class="text-xs text-stone-400 dark:text-stone-500 px-1 py-2">No recent reactions yet.</p>
            <% end %>
          </div>

          <div data-emoji-picker-target="allPanel" class="<%= 'hidden' if has_reacted_before %>">
            <emoji-picker data-emoji-picker-target="picker" data-action="emoji-click->emoji-picker#select"></emoji-picker>
          </div>
        </div>

        <%= form_with url: trip_trip_entry_reactions_path(@trip, @entry), method: :post, data: { emoji_picker_target: "form" }, class: "hidden" do |form| %>
          <%= form.hidden_field :emoji, data: { emoji_picker_target: "input" } %>
        <% end %>
      </div>
    <% end %>

    <% if @editable %>
      <dialog data-reaction-users-target="dialog" data-action="click->reaction-users#closeOnBackdrop"
        class="m-auto rounded-xl p-0 border-0 backdrop:bg-black/50 bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 w-full max-w-xs">
        <div class="p-5 flex items-start justify-between gap-3">
          <div data-reaction-users-target="content" class="text-sm text-stone-500 dark:text-stone-400 min-w-0 flex-1">Loading&hellip;</div>
          <button type="button" data-action="reaction-users#close" aria-label="Close"
            class="shrink-0 text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 cursor-pointer text-xl leading-none">&times;</button>
        </div>
      </dialog>
    <% end %>
  </div>

  <section class="mt-8">
    <h2 class="font-semibold text-lg mb-3 text-stone-800 dark:text-stone-100">Comments</h2>

    <% if authenticated? %>
      <%= form_with url: trip_trip_entry_comments_path(@trip, @entry), method: :post, scope: :comment, class: "mb-5" do |form| %>
        <%= form.text_area :body, rows: 2, placeholder: "Add a comment…",
              class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
        <%= form.submit "Post", class: "mt-2 rounded-md px-4 py-1.5 bg-amber-700 hover:bg-amber-600 text-white text-sm font-medium cursor-pointer" %>
      <% end %>
    <% else %>
      <p class="text-sm text-stone-500 dark:text-stone-400 mb-5">
        <%= link_to "Sign in", new_session_path, class: "text-amber-700 dark:text-amber-400 underline" %> to comment or react.
      </p>
    <% end %>

    <div class="space-y-4">
      <% @comments.each do |comment| %>
        <%= render "comment", comment: comment %>
      <% end %>
      <% if @comments.empty? %>
        <p class="text-sm text-stone-400 dark:text-stone-500">No comments yet.</p>
      <% end %>
    </div>
  </section>
</div>
