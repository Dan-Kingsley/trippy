<% content_for :title, "#{@entry.title} - #{@trip.title} - Trippy" %>

<%= link_to "&larr; #{@trip.title}".html_safe, trip_path(@trip), class: "text-sm text-stone-500 dark:text-stone-400 hover:text-amber-700 dark:hover:text-amber-400 mb-4 inline-block" %>

<% if @editable %>
  <div class="flex gap-2 mb-4">
    <%= link_to "Edit entry", edit_trip_trip_entry_path(@trip, @entry), class: "rounded-md px-3 py-1.5 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 text-sm font-medium" %>
    <%= button_to "Delete entry", trip_trip_entry_path(@trip, @entry), method: :delete,
          form: { data: { turbo_confirm: "Delete this entry and its photos?" } },
          class: "rounded-md px-3 py-1.5 bg-red-50 dark:bg-red-900/30 hover:bg-red-100 dark:hover:bg-red-900/50 text-red-700 dark:text-red-300 text-sm font-medium cursor-pointer" %>
  </div>
<% end %>

<div data-controller="carousel" data-action="keydown@window->carousel#closeOnEscape">
  <% if @entry.photos.any? %>
    <div class="relative rounded-xl overflow-hidden bg-stone-200 dark:bg-stone-800">
      <div data-carousel-target="track" class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">
        <% @entry.photos.each do |photo| %>
          <div class="snap-center shrink-0 w-full aspect-[4/3] sm:aspect-[16/9]">
            <%= image_tag photo.image.variant(resize_to_limit: [ 1600, 1600 ], saver: { quality: 85 }),
                  class: "w-full h-full object-cover cursor-zoom-in",
                  data: { action: "click->carousel#open", full_src: url_for(photo.image.variant(resize_to_limit: [ 3000, 3000 ], saver: { quality: 90 })) } %>
          </div>
        <% end %>
      </div>

      <% if @entry.photos.size > 1 %>
        <button type="button" data-action="carousel#prev" aria-label="Previous photo"
          class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">&#8249;</button>
        <button type="button" data-action="carousel#next" aria-label="Next photo"
          class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 hover:bg-black/60 text-white rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">&#8250;</button>

        <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1.5">
          <% @entry.photos.each_with_index do |_photo, i| %>
            <button type="button" data-action="carousel#goTo" data-index="<%= i %>" aria-label="Go to photo <%= i + 1 %>"
              class="w-2 h-2 rounded-full <%= i == 0 ? 'bg-white' : 'bg-white/40' %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div data-carousel-target="lightbox" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4" data-action="click->carousel#close">
    <img data-carousel-target="lightboxImage" class="max-w-full max-h-full object-contain" src="">
  </div>
</div>

<div class="mt-6 max-w-2xl">
  <h1 class="font-bold text-3xl text-stone-800 dark:text-stone-100"><%= @entry.title %></h1>
  <div class="flex items-center gap-2 mt-2">
    <div class="flex -space-x-2">
      <% @entry.participants.each do |user| %>
        <%= avatar_tag user, size: 56, css_class: "w-7 h-7 text-xs ring-2 ring-stone-50 dark:ring-stone-900" %>
      <% end %>
    </div>
    <% if @trip_member %>
      <p class="text-xs text-stone-500 dark:text-stone-400"><%= pluralize(@entry.views_count, "view") %></p>
    <% end %>
  </div>
  <% if @entry.description.present? %>
    <div class="prose-trip mt-3 text-stone-700 dark:text-stone-200"><%= render_markdown(@entry.description) %></div>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 mt-5">
    <% @entry.displayed_reaction_emojis.each do |emoji| %>
      <% count = @entry.reaction_counts[emoji].to_i %>
      <% mine = authenticated? && @entry.reactions.exists?(user: Current.user, emoji: emoji) %>
      <% if authenticated? %>
        <%= button_to "#{emoji} #{count > 0 ? count : ''}".strip, trip_trip_entry_reactions_path(@trip, @entry), method: :post,
              params: { emoji: emoji },
              class: "rounded-full px-3 py-1 text-sm border #{mine ? 'bg-amber-100 dark:bg-amber-900/40 border-amber-300 dark:border-amber-700' : 'bg-stone-100 dark:bg-stone-800 border-stone-200 dark:border-stone-700'} cursor-pointer" %>
      <% else %>
        <span class="rounded-full px-3 py-1 text-sm border bg-stone-100 dark:bg-stone-800 border-stone-200 dark:border-stone-700"><%= emoji %> <%= count > 0 ? count : "" %></span>
      <% end %>
    <% end %>

    <% if authenticated? %>
      <div class="relative" data-controller="emoji-picker">
        <button type="button" data-action="emoji-picker#toggle" aria-label="Add another reaction"
          class="rounded-full w-7 h-7 flex items-center justify-center text-sm border bg-stone-100 dark:bg-stone-800 border-stone-200 dark:border-stone-700 hover:bg-stone-200 dark:hover:bg-stone-700 cursor-pointer">+</button>

        <div data-emoji-picker-target="popover" class="hidden absolute z-10 top-full left-0 mt-1 shadow-lg rounded-lg overflow-hidden">
          <emoji-picker data-emoji-picker-target="picker" data-action="emoji-click->emoji-picker#select"></emoji-picker>
        </div>

        <%= form_with url: trip_trip_entry_reactions_path(@trip, @entry), method: :post, data: { emoji_picker_target: "form" }, class: "hidden" do |form| %>
          <%= form.hidden_field :emoji, data: { emoji_picker_target: "input" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <section class="mt-8">
    <h2 class="font-semibold text-lg mb-3 text-stone-800 dark:text-stone-100">Comments</h2>

    <% if authenticated? %>
      <%= form_with url: trip_trip_entry_comments_path(@trip, @entry), method: :post, scope: :comment, class: "mb-5" do |form| %>
        <%= form.text_area :body, rows: 2, placeholder: "Add a comment…",
              class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
        <%= form.submit "Post", class: "mt-2 rounded-md px-4 py-1.5 bg-amber-700 hover:bg-amber-600 text-white text-sm font-medium cursor-pointer" %>
      <% end %>
    <% else %>
      <p class="text-sm text-stone-500 dark:text-stone-400 mb-5">
        <%= link_to "Sign in", new_session_path, class: "text-amber-700 dark:text-amber-400 underline" %> to comment or react.
      </p>
    <% end %>

    <div class="space-y-4">
      <% @comments.each do |comment| %>
        <%= render "comment", comment: comment %>
      <% end %>
      <% if @comments.empty? %>
        <p class="text-sm text-stone-400 dark:text-stone-500">No comments yet.</p>
      <% end %>
    </div>
  </section>
</div>
