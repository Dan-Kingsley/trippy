<% if notice = flash[:notice] %>
  <p class="mb-4 rounded-lg bg-emerald-50 dark:bg-emerald-900/40 px-4 py-2.5 text-emerald-700 dark:text-emerald-300 font-medium"><%= notice %></p>
<% end %>
<% if alert = flash[:alert] %>
  <p class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/40 px-4 py-2.5 text-red-600 dark:text-red-300 font-medium"><%= alert %></p>
<% end %>
