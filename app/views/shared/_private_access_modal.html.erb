<div data-controller="modal">
  <button type="button" data-action="modal#open" aria-label="Enter a private trip code"
    class="p-1.5 sm:p-2 rounded-full text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-800 cursor-pointer">
    +
  </button>

  <dialog data-modal-target="dialog" class="m-auto rounded-xl p-0 border-0 backdrop:bg-black/50 bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 w-full max-w-md">
    <div class="p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-bold text-xl">Have a private trip code?</h2>
        <button type="button" data-action="modal#close" aria-label="Close"
          class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 cursor-pointer text-xl leading-none">&times;</button>
      </div>
      <%= form_with url: private_accesses_path, method: :post, class: "flex gap-2" do |form| %>
        <%= form.text_field :code, placeholder: "Enter 32-character code", maxlength: 32,
              class: "flex-1 min-w-0 rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
        <%= form.submit "View trip", class: "shrink-0 rounded-md px-4 py-2 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
      <% end %>
      <p class="text-xs text-stone-400 mt-2">Codes you enter (or open via a shared link) are remembered on this device.</p>
    </div>
  </dialog>
</div>
