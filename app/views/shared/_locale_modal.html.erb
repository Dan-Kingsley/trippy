<div data-controller="modal">
  <button type="button" data-action="modal#open" aria-label="<%= t("shared.locale_modal.choose_language_aria") %>"
    class="p-1.5 sm:p-2 rounded-full text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-800 cursor-pointer">
    <%= Locale::OPTIONS.fetch(I18n.locale.to_s, Locale::OPTIONS["en"]).first %>
  </button>

  <dialog data-modal-target="dialog" class="m-auto rounded-xl p-0 border-0 backdrop:bg-black/50 bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 w-full max-w-md">
    <div class="p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-bold text-xl"><%= t("shared.locale_modal.choose_language") %></h2>
        <button type="button" data-action="modal#close" aria-label="<%= t("shared.close") %>"
          class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 cursor-pointer text-xl leading-none">&times;</button>
      </div>
      <div class="space-y-2">
        <% Locale::OPTIONS.each do |code, (flag, label)| %>
          <%= button_to "#{flag} #{label}", locale_override_path, method: :post, params: { locale: code },
                class: "w-full text-left rounded-md px-4 py-2.5 cursor-pointer font-medium #{code == I18n.locale.to_s ? "bg-amber-700 text-white" : "bg-stone-100 dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200"}" %>
        <% end %>
      </div>
    </div>
  </dialog>
</div>
