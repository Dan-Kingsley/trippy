<% content_for :title, "Settings - Trippy" %>

<div class="mx-auto max-w-sm w-full py-8">
  <h1 class="font-bold text-3xl mb-6 text-stone-800 dark:text-stone-100">Settings</h1>

  <% if @user.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/40 px-4 py-2.5 text-red-600 dark:text-red-300 text-sm">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: settings_path, method: :patch, multipart: true, class: "space-y-5" do |form| %>
    <div class="flex items-center gap-4">
      <%= avatar_tag @user, size: 128, css_class: "w-16 h-16 text-xl" %>
      <div class="flex-1 min-w-0">
        <%= form.label :profile_picture, "Profile picture", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
        <%= form.file_field :profile_picture, accept: "image/*", class: "block w-full max-w-full text-sm" %>
      </div>
    </div>

    <div>
      <%= form.label :username, class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
      <%= form.text_field :username, required: true, autocomplete: "username",
            class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
    </div>

    <div class="border-t border-stone-200 dark:border-stone-800 pt-5">
      <p class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-3">Change password <span class="font-normal text-stone-400">(leave blank to keep your current password)</span></p>

      <div class="space-y-3">
        <div>
          <%= form.label :password, "New password", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.password_field :password, autocomplete: "new-password", maxlength: 72,
                class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
          <p class="text-xs text-stone-400 mt-1">At least 8 characters.</p>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72,
                class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
        </div>
      </div>
    </div>

    <%= form.submit "Save changes", class: "rounded-md px-4 py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
  <% end %>

  <% if @user.adventurer? %>
    <div class="border-t border-stone-200 dark:border-stone-800 pt-5 mt-5">
      <p class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-1">Import trips</p>
      <p class="text-xs text-stone-400 mb-3">Restore trips from a .zip file exported from Trippy (this or another instance).</p>

      <%= form_with url: import_path, method: :post, multipart: true, class: "space-y-3" do |form| %>
        <div>
          <%= form.label :archive, "Trippy export (.zip)", class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.file_field :archive, accept: ".zip,application/zip", required: true, class: "block w-full max-w-full text-sm" %>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1">If an imported trip matches one you already own</legend>
          <div class="space-y-1.5 text-sm text-stone-700 dark:text-stone-200">
            <label class="flex items-start gap-2">
              <input type="radio" name="conflict_policy" value="overwrite" checked class="mt-0.5">
              <span>Overwrite the matching trip <span class="text-stone-400">(replaces its entries, photos, comments and reactions entirely)</span></span>
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" name="conflict_policy" value="duplicate" class="mt-0.5">
              <span>Import alongside as a new copy <span class="text-stone-400">(keeps both; the copy won't be recognized as "the same trip" on future imports)</span></span>
            </label>
          </div>
        </fieldset>

        <%= form.submit "Import", class: "rounded-md px-4 py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
</div>
