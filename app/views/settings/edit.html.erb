<% content_for :title, "#{t("settings.edit.title")} - Trippy" %>

<div class="mx-auto max-w-sm w-full py-8">
  <h1 class="font-bold text-3xl mb-6 text-stone-800 dark:text-stone-100"><%= t("settings.edit.title") %></h1>

  <% if @user.errors.any? %>
    <div class="mb-4 rounded-lg bg-red-50 dark:bg-red-900/40 px-4 py-2.5 text-red-600 dark:text-red-300 text-sm">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: settings_path, method: :patch, multipart: true, class: "space-y-5", data: { controller: "direct-upload" } do |form| %>
    <div class="flex items-center gap-4">
      <%= avatar_tag @user, size: 128, css_class: "w-16 h-16 text-xl" %>
      <div class="flex-1 min-w-0">
        <%= form.label :profile_picture, t("settings.edit.profile_picture_label"), class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
        <%= form.file_field :profile_picture, accept: "image/*", direct_upload: true, class: "block w-full max-w-full text-sm",
              data: { action: "direct-upload:initialize->direct-upload#start direct-upload:progress->direct-upload#progress direct-upload:error->direct-upload#error direct-upload:end->direct-upload#end" } %>
        <div data-direct-upload-target="progressWrap" class="hidden mt-2 h-1.5 bg-stone-200 dark:bg-stone-800 rounded-full overflow-hidden">
          <div data-direct-upload-target="progressBar" class="h-full bg-amber-600 transition-all" style="width: 0%"></div>
        </div>
        <p data-direct-upload-target="error" class="hidden text-xs text-red-600 dark:text-red-400 mt-1"></p>
      </div>
    </div>

    <div>
      <%= form.label :username, class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
      <%= form.text_field :username, required: true, autocomplete: "username",
            class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
    </div>

    <div>
      <%= form.label :locale, t("settings.edit.language_label"), class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
      <%= form.select :locale, Locale.select_options, {},
            class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
    </div>

    <div class="border-t border-stone-200 dark:border-stone-800 pt-5">
      <p class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-3"><%= t("settings.edit.change_password") %> <span class="font-normal text-stone-400"><%= t("settings.edit.change_password_hint") %></span></p>

      <div class="space-y-3">
        <div>
          <%= form.label :password, t("settings.edit.new_password_label"), class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.password_field :password, autocomplete: "new-password", maxlength: 72,
                class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
          <p class="text-xs text-stone-400 mt-1"><%= t("settings.edit.password_hint") %></p>
        </div>

        <div>
          <%= form.label :password_confirmation, t("settings.edit.confirm_new_password_label"), class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72,
                class: "block w-full rounded-md border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-3 py-2 focus:outline-2 focus:outline-amber-600" %>
        </div>
      </div>
    </div>

    <%= form.submit t("settings.edit.save"), data: { direct_upload_target: "submit" },
          class: "rounded-md px-4 py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
  <% end %>

  <% if @user.adventurer? %>
    <div class="border-t border-stone-200 dark:border-stone-800 pt-5 mt-5">
      <p class="text-sm font-medium text-stone-600 dark:text-stone-300 mb-1"><%= t("settings.edit.import_trips") %></p>
      <p class="text-xs text-stone-400 mb-3"><%= t("settings.edit.import_description") %></p>

      <%= form_with url: import_path, method: :post, multipart: true, class: "space-y-3" do |form| %>
        <div>
          <%= form.label :archive, t("settings.edit.archive_label"), class: "block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1" %>
          <%= form.file_field :archive, accept: ".zip,application/zip", required: true, class: "block w-full max-w-full text-sm" %>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-stone-600 dark:text-stone-300 mb-1"><%= t("settings.edit.conflict_legend") %></legend>
          <div class="space-y-1.5 text-sm text-stone-700 dark:text-stone-200">
            <label class="flex items-start gap-2">
              <input type="radio" name="conflict_policy" value="overwrite" checked class="mt-0.5">
              <span><%= t("settings.edit.conflict_overwrite") %> <span class="text-stone-400"><%= t("settings.edit.conflict_overwrite_hint") %></span></span>
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" name="conflict_policy" value="duplicate" class="mt-0.5">
              <span><%= t("settings.edit.conflict_duplicate") %> <span class="text-stone-400"><%= t("settings.edit.conflict_duplicate_hint") %></span></span>
            </label>
          </div>
        </fieldset>

        <%= form.submit t("settings.edit.import_submit"), class: "rounded-md px-4 py-2.5 bg-amber-700 hover:bg-amber-600 text-white font-medium cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <div class="border-t border-stone-200 dark:border-stone-800 pt-5 mt-5">
    <%= button_to t("settings.edit.sign_out"), session_path, method: :delete, class: "rounded-md px-4 py-2.5 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 font-medium cursor-pointer" %>
  </div>
</div>
