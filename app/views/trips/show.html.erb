<% content_for :title, "#{@trip.title} - Trippy" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "leaflet", "data-turbo-track": "reload" %>
<% end %>

<div class="flex items-start justify-between gap-4 mb-4">
  <div>
    <h1 class="font-bold text-3xl text-stone-800 dark:text-stone-100"><%= @trip.title %></h1>
    <p class="text-sm text-stone-500 dark:text-stone-400 mt-1">
      <%= @trip.public? ? "Public trip" : "Private trip" %> &middot; <%= pluralize(@entries.size, "entry") %>
    </p>
    <div class="flex -space-x-2 mt-2">
      <% @trip.editors.each do |user| %>
        <%= avatar_tag user, size: 64, css_class: "w-8 h-8 text-xs ring-2 ring-stone-50 dark:ring-stone-900" %>
      <% end %>
    </div>
  </div>

  <% if @editable %>
    <div class="flex gap-2 shrink-0">
      <%= link_to "Add entry", new_trip_trip_entry_path(@trip), class: "rounded-md px-3 py-2 bg-amber-700 hover:bg-amber-600 text-white text-sm font-medium" %>
      <%= link_to "Edit trip", edit_trip_path(@trip), class: "rounded-md px-3 py-2 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 text-sm font-medium" %>
    </div>
  <% end %>
</div>

<% if !@trip.public? && @editable %>
  <div class="mb-4 rounded-lg bg-amber-50 dark:bg-amber-900/30 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
    Share this link so others can view without logging in:
    <code class="block mt-1 break-all bg-white/60 dark:bg-black/20 rounded px-2 py-1"><%= trip_url(@trip, code: @trip.secret_code) %></code>
  </div>
<% end %>

<div
  data-controller="trip-map"
  data-trip-map-entries-value="<%= @entries.map { |e|
      {
        id: e.id,
        lat: e.latitude,
        lng: e.longitude,
        title: e.title,
        url: trip_trip_entry_path(@trip, e),
        thumbnail_url: (e.photos.first&.image&.attached? ? url_for(e.photos.first.image.variant(resize_to_fill: [96, 96])) : nil)
      }
    }.to_json %>"
  class="w-full h-[50vh] sm:h-[60vh] rounded-xl border border-stone-200 dark:border-stone-800 z-0"
></div>

<% unlocated = @entries.reject(&:located?) %>
<% if @editable && unlocated.any? %>
  <div class="mt-4 rounded-lg bg-red-50 dark:bg-red-900/30 px-4 py-3 text-sm text-red-700 dark:text-red-300">
    <%= pluralize(unlocated.size, "entry") %> without a location yet:
    <% unlocated.each do |entry| %>
      <%= link_to entry.title, edit_trip_trip_entry_path(@trip, entry), class: "underline" %><%= ", " unless entry == unlocated.last %>
    <% end %>
  </div>
<% end %>

<section class="mt-8">
  <h2 class="font-semibold text-xl mb-3 text-stone-800 dark:text-stone-100">Entries</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @entries.each do |entry| %>
      <%= link_to trip_trip_entry_path(@trip, entry), class: "flex gap-3 items-center rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-3 hover:shadow-md transition-shadow" do %>
        <div class="relative shrink-0">
          <% if entry.photos.first %>
            <%= photo_thumb_tag entry.photos.first, size: 64, css_class: "w-16 h-16 rounded-lg object-cover" %>
          <% else %>
            <div class="w-16 h-16 rounded-lg bg-stone-200 dark:bg-stone-800 flex items-center justify-center">📍</div>
          <% end %>
          <div class="absolute -bottom-1.5 -right-1.5 flex -space-x-1.5">
            <% entry.participants.each do |user| %>
              <%= avatar_tag user, size: 32, css_class: "w-5 h-5 text-[8px] ring-2 ring-white dark:ring-stone-900" %>
            <% end %>
          </div>
        </div>
        <div class="min-w-0">
          <p class="font-medium text-stone-800 dark:text-stone-100 truncate"><%= entry.title %></p>
          <p class="text-xs text-stone-500 dark:text-stone-400"><%= entry.occurred_at&.to_date&.strftime("%-d %b %Y") %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
