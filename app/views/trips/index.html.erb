<% content_for :title, "#{t("trips.index.title")} - Trippy" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="font-bold text-3xl text-stone-800 dark:text-stone-100"><%= t("trips.index.heading") %></h1>
  <div class="flex gap-2">
    <% if @trips.any? %>
      <%= link_to t("trips.index.export_all"), trips_export_path, class: "rounded-md px-4 py-2 bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-700 dark:text-stone-200 font-medium" %>
    <% end %>
    <%= link_to t("trips.index.new_trip"), new_trip_path, class: "rounded-md px-4 py-2 bg-amber-700 hover:bg-amber-600 text-white font-medium" %>
  </div>
</div>

<% if @trips.any? %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @trips.each do |trip| %>
      <%= render "trips/card", trip: trip %>
    <% end %>
  </div>
<% else %>
  <p class="text-stone-500 dark:text-stone-400"><%= t("trips.index.empty") %></p>
<% end %>
